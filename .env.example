APP_NAME="Scents by Aamir"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Karachi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=sdb-70.hosting.stackcp.net
DB_PORT=3306
DB_DATABASE=scentsbyaamir-35303533b68d
DB_USERNAME=scentsbyaamiruser
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_TIMEOUT=10

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Used by php artisan db:seed to create/update the first super admin.
ADMIN_NAME="Scents by Aamir Admin"
ADMIN_EMAIL=admin@scentsbyaamir.com
ADMIN_PASSWORD=CHANGE_THIS_BEFORE_SEEDING

# Phase 13 — transactional email (use log locally, smtp in production)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=hello@scentsbyaamir.com
MAIL_FROM_NAME="Scents by Aamir"

# Phase 14/16 — WooCommerce one-time migration
# Use the WordPress site root URL (do NOT append /wp-json/wc/v3).
WOOCOMMERCE_URL=https://your-wordpress-site.com
WOOCOMMERCE_CONSUMER_KEY=ck_replace_with_read_key
WOOCOMMERCE_CONSUMER_SECRET=cs_replace_with_read_secret

# WordPress Journal one-time import
WORDPRESS_URL=https://scentsbyaamir.com
WORDPRESS_TIMEOUT=25
WORDPRESS_PER_PAGE=50
